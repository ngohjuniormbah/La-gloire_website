# MySQL-compatible managed database reachable from Vercel (required)
# Format: mysql://USER:PASSWORD@HOST:3306/DATABASE?ssl=true
DATABASE_URL=

# Set a long random password for the administrator (required in production)
ADMIN_PASSWORD=
# Generate with: openssl rand -hex 32
SESSION_SECRET=

# Required for admin uploads. Create a Vercel Blob store and copy its read/write token.
BLOB_READ_WRITE_TOKEN=

# Demo content for client presentations (sample photos, missions, testimonials, member icons).
# Shown only in sections that have no real content yet. Set to "false" and redeploy to remove all demo content.
NEXT_PUBLIC_SHOW_DEMO="true"
